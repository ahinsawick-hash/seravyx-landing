<mxfile host="app.diagrams.net"><diagram name="Fig2_business_model_canvas" id="Fig2_business_model_canvas"><mxGraphModel dx="1480" dy="740" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="740" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Business Model Canvas: Seravyx" style="text;whiteSpace=wrap;html=1;rounded=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontSize=20;fontColor=#172554;align=center;verticalAlign=middle;fontStyle=1;spacing=6;" vertex="1" parent="1"><mxGeometry x="0" y="8" width="1480" height="34" as="geometry"/></mxCell><mxCell id="c4" value="" style="whiteSpace=wrap;html=1;rounded=0;fillColor=#F8FAFF;strokeColor=#5B6372;strokeWidth=1.5;fontSize=13;fontColor=#03070E;align=center;verticalAlign=middle;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="280" height="440" as="geometry"/></mxCell><mxCell id="c5" value="Key partners" style="text;whiteSpace=wrap;html=1;rounded=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontSize=15;fontColor=#172554;align=left;verticalAlign=middle;fontStyle=1;spacing=6;" vertex="1" parent="1"><mxGeometry x="48" y="66" width="264" height="26" as="geometry"/></mxCell><mxCell id="c6" value="• Oncology clinicians at the National Cancer Institute&#xa;• Component suppliers and PCB manufacturers&#xa;• Biomedical engineering advisors&#xa;• In future: cancer charities and insurers" style="text;whiteSpace=wrap;html=1;rounded=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontSize=12.5;fontColor=#03070E;align=left;verticalAlign=top;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry x="48" y="96" width="264" height="396" as="geometry"/></mxCell><mxCell id="c7" value="" style="whiteSpace=wrap;html=1;rounded=0;fillColor=#F8FAFF;strokeColor=#5B6372;strokeWidth=1.5;fontSize=13;fontColor=#03070E;align=center;verticalAlign=middle;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry x="320" y="60" width="280" height="220.0" as="geometry"/></mxCell><mxCell id="c8" value="Key activities" style="text;whiteSpace=wrap;html=1;rounded=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontSize=15;fontColor=#172554;align=left;verticalAlign=middle;fontStyle=1;spacing=6;" vertex="1" parent="1"><mxGeometry x="328" y="66" width="264" height="26" as="geometry"/></mxCell><mxCell id="c9" value="• Hardware and firmware development&#xa;• App development&#xa;• Clinical validation&#xa;• Manufacturing&#xa;• Customer support" style="text;whiteSpace=wrap;html=1;rounded=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontSize=12.5;fontColor=#03070E;align=left;verticalAlign=top;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry x="328" y="96" width="264" height="176.0" as="geometry"/></mxCell><mxCell id="c10" value="" style="whiteSpace=wrap;html=1;rounded=0;fillColor=#F8FAFF;strokeColor=#5B6372;strokeWidth=1.5;fontSize=13;fontColor=#03070E;align=center;verticalAlign=middle;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry x="320" y="280.0" width="280" height="220.0" as="geometry"/></mxCell><mxCell id="c11" value="Key resources" style="text;whiteSpace=wrap;html=1;rounded=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontSize=15;fontColor=#172554;align=left;verticalAlign=middle;fontStyle=1;spacing=6;" vertex="1" parent="1"><mxGeometry x="328" y="286.0" width="264" height="26" as="geometry"/></mxCell><mxCell id="c12" value="• Wearable hardware design&#xa;• NEWS2-based scoring software&#xa;• Validation data&#xa;• The project team" style="text;whiteSpace=wrap;html=1;rounded=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontSize=12.5;fontColor=#03070E;align=left;verticalAlign=top;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry x="328" y="316.0" width="264" height="176.0" as="geometry"/></mxCell><mxCell id="c13" value="" style="whiteSpace=wrap;html=1;rounded=0;fillColor=#E0EAFF;strokeColor=#5B6372;strokeWidth=1.5;fontSize=13;fontColor=#03070E;align=center;verticalAlign=middle;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry x="600" y="60" width="280" height="440" as="geometry"/></mxCell><mxCell id="c14" value="Value propositions" style="text;whiteSpace=wrap;html=1;rounded=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontSize=15;fontColor=#172554;align=left;verticalAlign=middle;fontStyle=1;spacing=6;" vertex="1" parent="1"><mxGeometry x="608" y="66" width="264" height="26" as="geometry"/></mxCell><mxCell id="c15" value="• Hospital-standard early warning at home&#xa;• Earlier, clearer decisions about when to return to hospital&#xa;• Reassurance for caregivers&#xa;• Low cost compared with hospital monitoring equipment" style="text;whiteSpace=wrap;html=1;rounded=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontSize=12.5;fontColor=#03070E;align=left;verticalAlign=top;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry x="608" y="96" width="264" height="396" as="geometry"/></mxCell><mxCell id="c16" value="" style="whiteSpace=wrap;html=1;rounded=0;fillColor=#F8FAFF;strokeColor=#5B6372;strokeWidth=1.5;fontSize=13;fontColor=#03070E;align=center;verticalAlign=middle;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry x="880" y="60" width="280" height="220.0" as="geometry"/></mxCell><mxCell id="c17" value="Customer relationships" style="text;whiteSpace=wrap;html=1;rounded=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontSize=15;fontColor=#172554;align=left;verticalAlign=middle;fontStyle=1;spacing=6;" vertex="1" parent="1"><mxGeometry x="888" y="66" width="264" height="26" as="geometry"/></mxCell><mxCell id="c18" value="• Onboarding at the treatment centre&#xa;• In-app guidance&#xa;• Support line" style="text;whiteSpace=wrap;html=1;rounded=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontSize=12.5;fontColor=#03070E;align=left;verticalAlign=top;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry x="888" y="96" width="264" height="176.0" as="geometry"/></mxCell><mxCell id="c19" value="" style="whiteSpace=wrap;html=1;rounded=0;fillColor=#F8FAFF;strokeColor=#5B6372;strokeWidth=1.5;fontSize=13;fontColor=#03070E;align=center;verticalAlign=middle;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry x="880" y="280.0" width="280" height="220.0" as="geometry"/></mxCell><mxCell id="c20" value="Channels" style="text;whiteSpace=wrap;html=1;rounded=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontSize=15;fontColor=#172554;align=left;verticalAlign=middle;fontStyle=1;spacing=6;" vertex="1" parent="1"><mxGeometry x="888" y="286.0" width="264" height="26" as="geometry"/></mxCell><mxCell id="c21" value="• Oncology units recommend it at the start of treatment&#xa;• Pharmacies&#xa;• seravyx.com and social media" style="text;whiteSpace=wrap;html=1;rounded=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontSize=12.5;fontColor=#03070E;align=left;verticalAlign=top;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry x="888" y="316.0" width="264" height="176.0" as="geometry"/></mxCell><mxCell id="c22" value="" style="whiteSpace=wrap;html=1;rounded=0;fillColor=#EDE9FE;strokeColor=#5B6372;strokeWidth=1.5;fontSize=13;fontColor=#03070E;align=center;verticalAlign=middle;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry x="1160" y="60" width="280" height="440" as="geometry"/></mxCell><mxCell id="c23" value="Customer segments" style="text;whiteSpace=wrap;html=1;rounded=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontSize=15;fontColor=#172554;align=left;verticalAlign=middle;fontStyle=1;spacing=6;" vertex="1" parent="1"><mxGeometry x="1168" y="66" width="264" height="26" as="geometry"/></mxCell><mxCell id="c24" value="• Primary: patients receiving chemotherapy and their family caregivers&#xa;• Secondary: private hospitals and oncology clinics offering home monitoring" style="text;whiteSpace=wrap;html=1;rounded=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontSize=12.5;fontColor=#03070E;align=left;verticalAlign=top;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry x="1168" y="96" width="264" height="396" as="geometry"/></mxCell><mxCell id="c25" value="" style="whiteSpace=wrap;html=1;rounded=0;fillColor=#F3F4F6;strokeColor=#5B6372;strokeWidth=1.5;fontSize=13;fontColor=#03070E;align=center;verticalAlign=middle;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="700.0" height="210" as="geometry"/></mxCell><mxCell id="c26" value="Cost structure" style="text;whiteSpace=wrap;html=1;rounded=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontSize=15;fontColor=#172554;align=left;verticalAlign=middle;fontStyle=1;spacing=6;" vertex="1" parent="1"><mxGeometry x="48" y="506" width="684.0" height="26" as="geometry"/></mxCell><mxCell id="c27" value="• Components and manufacturing&#xa;• Cloud hosting&#xa;• Validation and certification&#xa;• Marketing and support" style="text;whiteSpace=wrap;html=1;rounded=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontSize=12.5;fontColor=#03070E;align=left;verticalAlign=top;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry x="48" y="536" width="684.0" height="166" as="geometry"/></mxCell><mxCell id="c28" value="" style="whiteSpace=wrap;html=1;rounded=0;fillColor=#E3F1EF;strokeColor=#5B6372;strokeWidth=1.5;fontSize=13;fontColor=#03070E;align=center;verticalAlign=middle;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry x="740.0" y="500" width="700.0" height="210" as="geometry"/></mxCell><mxCell id="c29" value="Revenue streams" style="text;whiteSpace=wrap;html=1;rounded=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontSize=15;fontColor=#172554;align=left;verticalAlign=middle;fontStyle=1;spacing=6;" vertex="1" parent="1"><mxGeometry x="748.0" y="506" width="684.0" height="26" as="geometry"/></mxCell><mxCell id="c30" value="• Device sale or rental for the length of a chemotherapy course&#xa;• Optional app subscription&#xa;• Licensing to hospitals and clinics&#xa;[Pricing to be confirmed by the team]" style="text;whiteSpace=wrap;html=1;rounded=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontSize=12.5;fontColor=#03070E;align=left;verticalAlign=top;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry x="748.0" y="536" width="684.0" height="166" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>